<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF3EF"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6"
        android:background="#DDE8DE" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/analysisCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        android:layout_weight="4"
        app:cardBackgroundColor="#F7FAF8"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:strokeColor="#D0DED2"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/selectedLocationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Draw farm boundary: tap 3+ points on map"
                android:textColor="#55647A"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/dataSourceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Data source: ISRO satellite feed (simulated)"
                android:textColor="#4B8E5A"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/analyzeBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#14D71F"
                    android:text="Analyze Area"
                    android:textAllCaps="false"
                    android:textColor="#0F1A2D"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/clearAreaBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#DDE3DD"
                    android:text="Clear Area"
                    android:textAllCaps="false"
                    android:textColor="#2D3B4E" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/loadingBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="10dp"
                android:indeterminate="true"
                android:indeterminateTint="#14D71F"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/healthIndicator"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/dot_green" />

                <TextView
                    android:id="@+id/healthLabelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Overall Crop Health: --"
                    android:textColor="#0E1930"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/ndviText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="NDVI: --"
                android:textColor="#1B253C"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/ndviProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#14D71F" />

            <TextView
                android:id="@+id/eviText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="EVI: --"
                android:textColor="#1B253C"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/eviProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#14D71F" />

            <TextView
                android:id="@+id/nrdviText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="NRDVI: --"
                android:textColor="#1B253C"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/nrdviProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#14D71F" />

            <TextView
                android:id="@+id/msaviText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="MSAVI: --"
                android:textColor="#1B253C"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/msaviProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#14D71F" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
