<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical"
    android:background="@drawable/profile_card_bg"
    android:padding="14dp">

    <TextView
        android:id="@+id/textNotificationTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Notification"
        android:textColor="@color/profile_title"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textNotificationMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Message"
        android:textColor="@color/profile_chevron" />

    <TextView
        android:id="@+id/textNotificationTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="N/A"
        android:textColor="@color/profile_green"
        android:textSize="12sp" />

</LinearLayout>
