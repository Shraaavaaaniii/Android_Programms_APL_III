<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical"
    android:background="@drawable/profile_card_bg"
    android:padding="14dp">

    <TextView
        android:id="@+id/textFarmName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Farm"
        android:textColor="@color/profile_title"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textFarmCoordinates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0.000000, 0.000000"
        android:textColor="@color/profile_chevron" />

    <TextView
        android:id="@+id/textFarmDateAdded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="N/A"
        android:textColor="@color/profile_chevron" />

</LinearLayout>
